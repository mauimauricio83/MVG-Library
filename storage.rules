rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public site fetches the published catalog snapshot with a plain,
    // deterministic URL (no rotating download token needed) since read
    // access is unconditionally public here -- see fetchData()/SNAPSHOT_URL
    // in app.js. Only signed-in admins (per the `admins` Firestore
    // collection) can write a new snapshot, via the "Publish" button in the
    // admin panel.
    match /catalog/snapshot.json {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Profile photos for the musician/production directory (profiles/{uid}
    // in firestore.rules) -- one photo per account, client resizes before
    // upload (see uploadProfilePhoto() in app.js), 2MB cap here is just a
    // server-side backstop.
    match /profile-photos/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Blog post images (cover + inline body images, see the admin editor's
    // image-upload toolbar button in app.js) -- admin-only write, same 5MB
    // backstop pattern as the others, larger cap than profile photos since
    // these render at full article width rather than a small avatar.
    match /blog-images/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
