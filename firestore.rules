rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public site never talks to Firestore directly (it reads the published
    // JSON snapshot from Cloud Storage instead) -- only the admin panel does,
    // and only for signed-in admins.
    match /videos/{rowNum} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // meta/counters holds the next-available rowNum, atomically incremented
    // via a transaction when adding entries -- lets Add/Bulk Import reserve
    // fresh IDs without scanning the whole `videos` collection for the max.
    match /meta/{doc} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in user may read their OWN admin doc (to decide whether to show
    // admin UI) but can never write it -- prevents client-side privilege
    // escalation. Assigning admins is a manual Firebase Console / Admin SDK action.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Unchanged -- each signed-in user reads/writes only their own favorites/
    // recently-viewed doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Opt-in public mirror of just the favorites list (not recentlyViewed,
    // which stays private in /users) -- world-readable so a shared link
    // works for signed-out visitors, but only the owning account can
    // create/update/delete it. Doc presence means "sharing is on"; deleting
    // it (see shareFavoritesBtn's "Stop sharing" path) turns it back off.
    match /publicFavorites/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Members-only directory: musicians/directors/productions can post a
    // short profile (one YouTube reel + a photo) to be discovered by each
    // other -- signed-in only, not the public-read shape publicFavorites
    // uses, since this is meant to stay a members' space rather than
    // something signed-out visitors browse.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.role in ["musician", "director", "production"] &&
        request.resource.data.bio is string &&
        request.resource.data.bio.size() <= 500 &&
        (!("youtubeUrl" in request.resource.data) ||
          (request.resource.data.youtubeUrl is string && request.resource.data.youtubeUrl.size() <= 300)) &&
        (!("photoURL" in request.resource.data) ||
          (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500)) &&
        // Optional lat/lng pin (captured now for the matchmaking system
        // planned later) plus a best-effort reverse-geocoded label -- see
        // pickProfileLocation()/reverseGeocode() in app.js.
        (!("location" in request.resource.data) ||
          (request.resource.data.location.lat is number &&
            request.resource.data.location.lat >= -90 && request.resource.data.location.lat <= 90 &&
            request.resource.data.location.lng is number &&
            request.resource.data.location.lng >= -180 && request.resource.data.location.lng <= 180)) &&
        (!("locationLabel" in request.resource.data) ||
          (request.resource.data.locationLabel is string && request.resource.data.locationLabel.size() <= 120));
    }

    // "Request to collaborate" -- the first real matchmaking action beyond
    // just browsing Profiles. A request is only ever readable by its two
    // parties (query must filter by fromUid or toUid == the caller for a
    // list to satisfy this). fromEmail is pinned to the auth token's own
    // email claim so it can't be spoofed; on accept, the recipient reveals
    // their own email the same way -- this is the whole point of accepting
    // (no in-app messaging yet, so email is the actual hand-off).
    match /collabRequests/{id} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.fromEmail == request.auth.token.email &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 300;
      // Only the recipient can respond, only from pending, only to
      // accepted/declined -- fromUid/fromEmail/toUid are immutable past
      // creation (not listed as allowed to change, so any attempt to
      // rewrite them fails the exact-match implicit check below).
      allow update: if request.auth != null &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == "pending" &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.fromEmail == resource.data.fromEmail &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.status in ["accepted", "declined"] &&
        (request.resource.data.status != "accepted" ||
          request.resource.data.toEmail == request.auth.token.email);
      // Rescinding: only the original sender, and only while still
      // pending -- once accepted, deleting would desync acceptedPairs/
      // dmThreads (which key off this having happened), and a declined
      // request has nothing left to "cancel".
      allow delete: if request.auth != null &&
        resource.data.fromUid == request.auth.uid &&
        resource.data.status == "pending";
    }

    // Deterministic per-pair marker written once a collab request is
    // accepted (see respondToRequest() in app.js) -- exists purely so
    // dmThreads' create rule below can verify two people are actually
    // connected without an arbitrary query. Rules can only exists()/get() a
    // KNOWN path, and collabRequests' own doc IDs are auto-generated (not
    // derivable from the pair), so this reuses the same sorted-pair ID
    // scheme as dmThreads specifically so it CAN be checked that way.
    match /acceptedPairs/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        pairId == (request.resource.data.participants[0] < request.resource.data.participants[1]
          ? request.resource.data.participants[0] + "_" + request.resource.data.participants[1]
          : request.resource.data.participants[1] + "_" + request.resource.data.participants[0]);
      allow update, delete: if false;
    }

    // Private 1:1 DM threads -- only ever between two people with an
    // accepted collab request (acceptedPairs above gates creation).
    // threadId is the same deterministic sorted-pair scheme, so there's at
    // most one thread per pair and both directions resolve to the same doc.
    match /dmThreads/{threadId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        threadId == (request.resource.data.participants[0] < request.resource.data.participants[1]
          ? request.resource.data.participants[0] + "_" + request.resource.data.participants[1]
          : request.resource.data.participants[1] + "_" + request.resource.data.participants[0]) &&
        exists(/databases/$(database)/documents/acceptedPairs/$(threadId));
      // participants is immutable past creation; lastMessage* fields (set
      // alongside each new message, see the messages create rule below)
      // are otherwise free to update by either participant.
      allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
        allow create: if request.auth != null &&
          !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) &&
          request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Message board: anyone (including signed-out visitors) can read, but
    // posting requires sign-in and being neither muted nor banned. Messages
    // are otherwise immutable -- no client-side edits, only admin delete
    // (single-message moderation, or the bulk delete a ban triggers).
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        !exists(/databases/$(database)/documents/mutedUsers/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
      allow update: if false;
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Per-video comments -- same shape/rules as the message board's
    // `messages` collection (public read, signed-in + not muted/banned to
    // post, admin-only delete, no client-side edits), just filtered by
    // rowNum instead of being one global feed. Needs a composite
    // (rowNum, createdAt) index -- see firestore.indexes.json.
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.rowNum is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        !exists(/databases/$(database)/documents/mutedUsers/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
      allow update: if false;
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Blog-post comments -- same shape/rules as the per-video `comments`
    // collection above, just keyed by postSlug instead of rowNum (blog.html
    // is a standalone page with no rowNum concept). Needs a composite
    // (postSlug, createdAt) index -- see firestore.indexes.json.
    match /blogComments/{id} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.postSlug is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        !exists(/databases/$(database)/documents/mutedUsers/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
      allow update: if false;
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Crowdsourced single-field edit suggestions -- a visitor proposes a
    // correction (see openSuggestEditModal() in app.js), an admin Accepts
    // (applies it to the `videos` doc) or Declines. currentValue/entryLabel
    // are a snapshot at submission time (display only, not re-validated),
    // so nothing here trusts them beyond size limits. A submitter can read
    // their own suggestions to see status; admins can read/update all.
    match /editSuggestions/{id} {
      allow read: if request.auth != null &&
        (resource.data.submittedByUid == request.auth.uid ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) &&
        request.resource.data.submittedByUid == request.auth.uid &&
        request.resource.data.rowNum is string &&
        request.resource.data.field is string &&
        request.resource.data.suggestedValue is string &&
        request.resource.data.suggestedValue.size() > 0 &&
        request.resource.data.suggestedValue.size() <= 500 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 300 &&
        request.resource.data.currentValue is string &&
        request.resource.data.currentValue.size() <= 500 &&
        request.resource.data.fieldLabel is string &&
        request.resource.data.fieldLabel.size() <= 60 &&
        request.resource.data.entryLabel is string &&
        request.resource.data.entryLabel.size() <= 200 &&
        request.resource.data.submittedByName is string &&
        request.resource.data.submittedByName.size() <= 100 &&
        request.resource.data.status == "pending";
      // Only an admin can respond, and only status may change.
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        request.resource.data.rowNum == resource.data.rowNum &&
        request.resource.data.field == resource.data.field &&
        request.resource.data.suggestedValue == resource.data.suggestedValue &&
        request.resource.data.submittedByUid == resource.data.submittedByUid &&
        request.resource.data.status in ["accepted", "declined"];
      allow delete: if false;
    }

    // Verification review workflow (private) -- see verifiedProfiles below
    // for the public-facing flag this produces. A profile owner requests,
    // an admin Approves/Declines (see the admin panel's Verification
    // Requests view in app.js); matchedRowNums is just a display snapshot
    // for the admin, not re-validated against the catalog here.
    match /verificationRequests/{id} {
      allow read: if request.auth != null &&
        (resource.data.profileUid == request.auth.uid ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null &&
        request.resource.data.profileUid == request.auth.uid &&
        request.resource.data.profileName is string &&
        request.resource.data.profileName.size() <= 60 &&
        request.resource.data.matchedRowNums is list &&
        request.resource.data.matchedRowNums.size() <= 12 &&
        request.resource.data.status == "pending";
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        request.resource.data.profileUid == resource.data.profileUid &&
        request.resource.data.status in ["approved", "declined"];
      allow delete: if false;
    }

    // Public "is this uid verified" flag -- doc presence = verified, world-
    // readable so profile cards/lightboxes can show the badge to anyone,
    // admin-only to set. Deliberately its OWN collection rather than a
    // `verified` field on profiles/{uid}, since that collection's write
    // rule only ever allows the owner to write their own doc -- approving
    // someone else's verification would otherwise need a carve-out there.
    match /verifiedProfiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Self-hosted blog (replacing the Squarespace-fed News feed over time --
    // see blog.html / the admin panel's Blog Posts view in app.js). Public
    // can read published posts (a list query already filtered to
    // status=="published" is what makes the OR below safe for both get and
    // list); admins can read/write everything including drafts.
    match /blogPosts/{id} {
      allow read: if resource.data.status == "published" ||
        (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Moderation flags for the message board. Readable by anyone so a
    // muted/banned visitor's own client can show why posting is blocked
    // (enforcement itself happens server-side via the /messages rule above,
    // not this read access) -- only admins can set/clear them.
    match /mutedUsers/{uid} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /bannedUsers/{uid} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
