rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public site never talks to Firestore directly (it reads the published
    // JSON snapshot from Cloud Storage instead) -- only the admin panel does,
    // and only for signed-in admins.
    match /videos/{rowNum} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // meta/counters holds the next-available rowNum, atomically incremented
    // via a transaction when adding entries -- lets Add/Bulk Import reserve
    // fresh IDs without scanning the whole `videos` collection for the max.
    match /meta/{doc} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in user may read their OWN admin doc (to decide whether to show
    // admin UI) but can never write it -- prevents client-side privilege
    // escalation. Assigning admins is a manual Firebase Console / Admin SDK action.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Unchanged -- each signed-in user reads/writes only their own favorites/
    // recently-viewed doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Opt-in public mirror of just the favorites list (not recentlyViewed,
    // which stays private in /users) -- world-readable so a shared link
    // works for signed-out visitors, but only the owning account can
    // create/update/delete it. Doc presence means "sharing is on"; deleting
    // it (see shareFavoritesBtn's "Stop sharing" path) turns it back off.
    match /publicFavorites/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Public directory: musicians/directors/productions can post a short
    // profile (one YouTube reel + a photo) to be discovered by each other.
    // Same public-read/owner-write shape as publicFavorites above, plus
    // field validation and the banned-user gate reused from /messages,
    // since this is also user-generated content visible to everyone.
    match /profiles/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.role in ["musician", "director", "production"] &&
        request.resource.data.bio is string &&
        request.resource.data.bio.size() <= 500 &&
        (!("youtubeUrl" in request.resource.data) ||
          (request.resource.data.youtubeUrl is string && request.resource.data.youtubeUrl.size() <= 300)) &&
        (!("photoURL" in request.resource.data) ||
          (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500));
    }

    // Message board: anyone (including signed-out visitors) can read, but
    // posting requires sign-in and being neither muted nor banned. Messages
    // are otherwise immutable -- no client-side edits, only admin delete
    // (single-message moderation, or the bulk delete a ban triggers).
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        !exists(/databases/$(database)/documents/mutedUsers/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
      allow update: if false;
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Moderation flags for the message board. Readable by anyone so a
    // muted/banned visitor's own client can show why posting is blocked
    // (enforcement itself happens server-side via the /messages rule above,
    // not this read access) -- only admins can set/clear them.
    match /mutedUsers/{uid} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /bannedUsers/{uid} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
